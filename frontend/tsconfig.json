{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"strict": true,
		"types": ["svelte", "vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}